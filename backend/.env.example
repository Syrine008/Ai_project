# Local development. Production: set DEBUG=0, a secret, hosts and HTTPS origins.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY=generate-a-random-secret-at-least-50-characters
# CORS_ALLOWED_ORIGINS=https://brain.example.org
# CSRF_TRUSTED_ORIGINS=https://brain.example.org
# DJANGO_TRUST_PROXY=1
# Enable only behind a trusted proxy that strips incoming forwarding headers.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SMTP settings are optional; use deployment secrets, never commit passwords.
